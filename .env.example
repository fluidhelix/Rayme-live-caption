# Keep your existing .env. Windows mode never needs DISCORD_TOKEN.
# Existing shared installation (absolute paths are supported).
WHISPER_SERVER_EXE=./whisper/Release/whisper-server.exe
WHISPER_MODEL=./whisper/ggml-large-v3-turbo.bin
WHISPER_GPU=true
WHISPER_THREADS=4
# Optional Windows-mode-only overrides; leave device empty for default output.
WINDOWS_AUDIO_DEVICE=
WINDOWS_CAPTION_PORT=8090
WINDOWS_SILENCE_RMS=80
