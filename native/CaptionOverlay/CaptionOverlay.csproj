<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType><TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF><UseWindowsForms>true</UseWindowsForms><EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable><ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>CaptionOverlay</AssemblyName>
    <ApplicationIcon>Assets/Rayme.ico</ApplicationIcon>
    <!-- WPF owns DPI awareness via the manifest; WinForms is used only for NotifyIcon. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
  </PropertyGroup>
  <PropertyGroup Condition="'$(RaymeDistribution)' == 'true'"><DefineConstants>$(DefineConstants);RAYME_DISTRIBUTION</DefineConstants></PropertyGroup>
  <ItemGroup><ProjectReference Include="../CaptionOverlay.Core/CaptionOverlay.Core.csproj" /></ItemGroup>
  <ItemGroup><Resource Include="Assets/Rayme.ico" /></ItemGroup>
  <ItemGroup Condition="'$(RaymeDistribution)' == 'true'"><Compile Remove="OverlayWindow.Smoke.cs" /></ItemGroup>
</Project>
